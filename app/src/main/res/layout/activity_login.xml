<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_degradado"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <!-- Logo / icono de la app -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="8dp" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio de Sesión"
            android:textSize="26sp"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:fontFamily="@font/abeezee"
            android:layout_marginBottom="40dp" />

        <!-- Label Usuario -->
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuario:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="6dp" />

        <!-- Campo Usuario -->
        <EditText
            android:id="@+id/etUsuario"
            android:background="@drawable/bg_redondo"
            android:drawableStart="@drawable/person"
            android:drawablePadding="10dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:hint="Indica tu usuario"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_grey"
            android:textSize="15sp" />

        <!-- Label Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="6dp" />

        <!-- Campo Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:background="@drawable/bg_redondo"
            android:drawableStart="@drawable/candadoo"
            android:drawablePadding="10dp"
            android:layout_height="52dp"
            android:hint="Indica tu contraseña"
            android:textColorHint="@color/text_grey"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:paddingHorizontal="18dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:layout_marginBottom="40dp" />

        <!-- Botón Login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:text="Iniciar Sesion"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"

            backgroundTint="@color/purple_200"

            app:cornerRadius="26dp"

            app:strokeWidth="2dp"
            app:strokeColor="@color/white" />

        <!-- ProgressBar (oculto, se muestra durante la llamada) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>