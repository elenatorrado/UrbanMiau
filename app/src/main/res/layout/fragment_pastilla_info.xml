<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_degradado"
    android:padding="24dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pastillas"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>


    <ImageView
        android:id="@+id/imgPastillas"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:scaleType="fitCenter"
        android:src="@drawable/pastillasimg"
        android:layout_marginBottom="32dp"/>


    <TextView
        android:id="@+id/txtTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_spinner"
        android:padding="8dp"
        android:layout_marginBottom="24dp"/>

    <!-- Gatos -->
    <TextView
        android:id="@+id/txtGatos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gatos:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtListaGatos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Michifú\n• Atila\n• Sofi\n• Coco\n• Luna"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:lineSpacingExtra="6dp"/>

</LinearLayout>